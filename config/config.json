{
  "training": {
    "episodes": 200000,
    "max_steps_per_episode": 500,
    "seed": 42,
    "train_frequency": 1,
    "torch_threads": 4,
    "num_workers": 8,
    "evaluation_interval": 5000,
    "evaluation_episodes": 25,
    "surveillance_interval": 100
  },
  "dqn": {
    "learning_rate": 0.00025,
    "gamma": 0.99,
    "batch_size": 64,
    "replay_buffer_size": 100000,
    "target_update_frequency": 1000,
    "deduplicate_transitions": false
  },
  "exploration": {
    "epsilon_start": 1.0,
    "epsilon_min": 0.05,
    "epsilon_decay": 0.999995
  },
  "network": {
    "type": "CNN",
    "hidden_layers": [128, 128],
    "cnn": {
      "channels": [16, 32],
      "kernel_size": 3,
      "padding": 1
    }
  },
  "environment": {
    "difficulty": "Medium"
  },
  "reward": {
    "invalid_action": -1.0,
    "score_per_point": 1.0,
    "step_penalty": 0.001,
    "game_over_penalty": 1.0,
    "line_rewards": {
      "5": 10.0,
      "6": 12.0,
      "7": 14.0,
      "8": 16.0,
      "9": 18.0
    }
  }
}
